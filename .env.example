# DeepSeek（当前默认）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Google Gemini（比赛要求）
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Anthropic Claude（可选对比）
ANTHROPIC_API_KEY=

# 应用配置
# LLM_PROVIDER 可选: deepseek / gemini / claude
LLM_PROVIDER=deepseek
APP_ENV=development
DB_PATH=./data/db/learners.db
