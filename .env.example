# 本地优先，先开发后接模型。仅在部署并确认模型后显式改为 true。
# 未设置开关的旧部署保持原行为；新部署请复制并保留此处 false。
MODEL_ENABLED=false
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 运行 ollama list 后填写本机已安装的准确标签；不自动下载权重。
OLLAMA_MODEL=
MODEL_TIMEOUT_SECONDS=30
# 输入按 UTF-8 字节保守估算 token 上界，超限直接拒绝；输出传 Provider 硬上限。
MODEL_MAX_INPUT_TOKENS=16000
MODEL_MAX_OUTPUT_TOKENS=4096
# 客服共享 UTC 日预算；失败或缺 usage 时按最大预留保守计数。
# 0 表示禁止调用，金额上限留空表示不启用；配置金额上限须同时配置对应单价。
MODEL_DAILY_CALL_LIMIT=200
MODEL_DAILY_TOKEN_LIMIT=200000
MODEL_DAILY_COST_LIMIT=

# DeepSeek（可选云服务，仅在显式切换 Provider 后调用）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Optional cost estimation, in the provider's billing currency per million tokens.
# Leave blank to show unknown; these are estimates, not invoices.
DEEPSEEK_INPUT_PRICE_PER_MILLION=
DEEPSEEK_OUTPUT_PRICE_PER_MILLION=

# Google Gemini（比赛要求）
GOOGLE_API_KEY=
GEMINI_MODEL=

# Anthropic Claude（可选对比）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# 应用配置
# LLM_PROVIDER: deepseek / ollama (legacy adapters: gemini / claude)
APP_ENV=development
DB_PATH=./data/db/learners.db
SUPPORT_DB_PATH=./data/db/support.db
SUPPORT_API_URL=http://127.0.0.1:8080
SUPPORT_CREATE_LIMIT_PER_HOUR=20
SUPPORT_MESSAGE_LIMIT_PER_MINUTE=20
# 只预览/清理已关闭且超过期限的会话，不自动删除开放会话。
SUPPORT_RETENTION_DAYS=30
# Generate a strong private token locally. Never put a real token in this template.
ADMIN_API_TOKEN=
